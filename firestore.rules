rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Semua orang boleh MEMBACA isi situs
    // Hanya email Google Anda yang boleh MENGUBAH
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'ejafer19a@gmail.com'
                   && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
